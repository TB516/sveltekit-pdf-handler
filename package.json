{
  "name": "sveltekit-pdf-renderer",
  "version": "0.2.0",
  "description": "Render Svelte components as PDF responses from SvelteKit endpoints.",
  "keywords": [
    "pdf",
    "puppeteer",
    "server-side-rendering",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://github.com/TB516/sveltekit-pdf-handler#readme",
  "bugs": {
    "url": "https://github.com/TB516/sveltekit-pdf-handler/issues"
  },
  "license": "BSD-3-Clause",
  "author": "TB516",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TB516/sveltekit-pdf-handler.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "effect-language-service patch",
    "prepublishOnly": "pnpm format:check && pnpm lint && pnpm check && pnpm build"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108",
    "puppeteer": "^25.5.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0",
    "svelte": ">=5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0"
}
