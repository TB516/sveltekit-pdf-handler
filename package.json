{
  "name": "sveltekit-pdf",
  "version": "0.0.0",
  "description": "Render Svelte components as PDF responses from SvelteKit endpoints.",
  "license": "BSD-3-Clause",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "puppeteer": "^25.5.0"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0",
    "svelte": ">=5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0"
}
